# Copy to .env (bin/owui setup does this for you). Never commit .env.
# Any variable already set in your shell environment overrides the value here.

# Your NCSA Lumen API key. Required.
LUMEN_API_KEY=

# Signs login sessions. bin/owui setup generates one if empty.
# Use the same value on every machine you sync between.
WEBUI_SECRET_KEY=

# Open Terminal: give the AI a Linux workspace with access to one folder.
# Remove "terminal" to run Open WebUI alone.
COMPOSE_PROFILES=terminal
# Generated by bin/owui setup if empty. Paste it into Open WebUI when connecting the terminal.
OPEN_TERMINAL_API_KEY=

# Leave empty for text-only models (most Lumen models). Set to "image" only if every
# model you use accepts images; otherwise reading a plot breaks the chat.
TERMINAL_BINARY_MIME_PREFIXES=

# Folder on your computer the AI can read and write. Default: ~/owui-workspace
OWUI_WORKSPACE=

# Where Open WebUI keeps chats, settings, and uploads. Default: ~/openwebui-data
OWUI_DATA=

# Local port for the web interface: http://localhost:3000
OWUI_PORT=3000

# Image versions. Pin a release (for example v0.x.y) to avoid surprise upgrades.
OWUI_TAG=main
TERMINAL_TAG=latest

# Single-user mode (no login). Set to True before first launch if others will use this instance.
WEBUI_AUTH=False

# Only needed if WEBUI_AUTH=True: an Open WebUI API key (Settings > Account) so
# bin/owui connect-terminal can configure the terminal for you.
OWUI_API_KEY=

# Optional: other machine for bin/owui push / pull (an ssh host name).
OWUI_REMOTE=
